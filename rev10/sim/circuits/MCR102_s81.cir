* ============ M61-M64 : 4T SPLIT-BRANCH DRIFT SERVO ================
X61 n1 n1 vdd potft W=20 L=10 DVTH=-0.10898   $ M_S1 diode master
X62 0 0 n1 potft W=20 L=10 DVTH=-0.07512   $ M_S2 self-biased pull-down
X63 comp n1 vdd potft W=20 L=10 DVTH=-0.13029   $ M_S3 mirror slave
X64 0 0 comp potft W=33 L=10 DVTH=-0.05199   $ M_S4 tracking load

* ============ M65-M66 : SHARED LEVEL-SHIFT REFERENCE ===============
X65 vls n1 vdd potft W=790 L=5 DVTH=-0.02649   $ M_LSB bias current source
X66 0 ref vls potft W=320 L=10 DVTH=-0.03600  $ M_LS  reference follower

* ============ M67-M69 : SAMPLER + DUMMY + C_ref RESET ==============
X67 ref phib acom potft W=40 L=5 DVTH=0.10338    $ M_smp sampling switch
X68 ref phi ref potft W=20 L=5 DVTH=-0.00300    $ M_dum feedthrough dummy
X69 0 rstb ref potft W=20 L=5 DVTH=0.05495    $ C_ref reset switch

* ============ M70-M74 : A- COLUMN STEERING (Phase B only) =========
X70 acom phib acol1 potft W=40 L=5 DVTH=0.17241
X71 acom phib acol2 potft W=40 L=5 DVTH=0.06465
X72 acom phib acol3 potft W=40 L=5 DVTH=-0.00174
X73 acom phib acol4 potft W=40 L=5 DVTH=-0.11505
X74 acom phib acol5 potft W=40 L=5 DVTH=0.07828

* ============ M75-M79 : A+ RAIL RESET SWITCHES ====================
X75 0 rstr ap1 potft W=400 L=20 DVTH=0.00726
X76 0 rstr ap2 potft W=400 L=20 DVTH=0.01631
X77 0 rstr ap3 potft W=400 L=20 DVTH=-0.00246
X78 0 rstr ap4 potft W=400 L=20 DVTH=-0.00635
X79 0 rstr ap5 potft W=400 L=20 DVTH=-0.03418

* ============ M80 : GLOBAL WIN-BAR PULL-UP ========================
X80 0 0 win potft W=5 L=20 DVTH=0.07612   $ idle pull-down of win
XI1 lockb win vdd potft W=40 L=5 DVTH=-0.16081   $ inverter pull-up
XI2 0 0 lockb potft W=10 L=5 DVTH=-0.10899   $ inverter load

* ====== M81-M130 : PER-CLASS COMPARATOR + LATCH + LOCKOUT =========
* ---- class 1 (M81-M90) ----
X81 d1 ap1 vls potft W=468 L=15 DVTH=0.00772    $ M_sense gate-isolated
X82 0 0 d1 potft W=20 L=20 DVTH=0.00141   $ M_dl detect load (bootstrapped gate)
X83 na1 d1 vdd potft W=200 L=10 DVTH=-0.00475    $ M_T trip driver
X84 0 0 na1 potft W=10 L=20 DVTH=0.04013   $ M_A_L latch load A
X85 na1 nb1 vdd potft W=60 L=5 DVTH=-0.15266    $ M_X cross-coupled
X86 nb1 na1 vdd potft W=60 L=5 DVTH=-0.00066    $ M_Y cross-coupled
X87 0 0 nb1 potft W=20 L=5 DVTH=0.17372    $ M_B_L latch load B
X88 nb1 rstr vdd potft W=40 L=5 DVTH=0.11244    $ M_rst latch reset
X89 d1 lockb vdd potft W=20 L=5 DVTH=-0.22501   $ lock: pulls d1 high when lockb low
X90 win nb1 vdd potft W=80 L=5 DVTH=0.06407   $ P_k: wired-OR pull-up of win

* ---- class 2 (M91-M100) ----
X91 d2 ap2 vls potft W=468 L=15 DVTH=0.00650
X92 0 0 d2 potft W=20 L=20 DVTH=-0.07557
X93 na2 d2 vdd potft W=200 L=10 DVTH=-0.04594
X94 0 0 na2 potft W=10 L=20 DVTH=-0.02142
X95 na2 nb2 vdd potft W=60 L=5 DVTH=0.11061
X96 nb2 na2 vdd potft W=60 L=5 DVTH=0.03498
X97 0 0 nb2 potft W=20 L=5 DVTH=-0.14585
X98 nb2 rstr vdd potft W=40 L=5 DVTH=0.00435
X99 d2 lockb vdd potft W=20 L=5 DVTH=0.14272   $ lock: pulls d2 high when lockb low
X100 win nb2 vdd potft W=80 L=5 DVTH=-0.01095   $ P_k: wired-OR pull-up of win

* ---- class 3 (M101-M110) ----
X101 d3 ap3 vls potft W=468 L=15 DVTH=-0.00906
X102 0 0 d3 potft W=20 L=20 DVTH=0.02894
X103 na3 d3 vdd potft W=200 L=10 DVTH=-0.06948
X104 0 0 na3 potft W=10 L=20 DVTH=0.03836
X105 na3 nb3 vdd potft W=60 L=5 DVTH=-0.11932
X106 nb3 na3 vdd potft W=60 L=5 DVTH=-0.01257
