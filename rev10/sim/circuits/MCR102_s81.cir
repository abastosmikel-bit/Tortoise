* ==================================================================
* TRACE-2 FINAL (frozen)  Rev-4 Autonomous  (Time-Race Accumulating Charge-trap Element)
* 6-input x 5-class autonomous unipolar p-OTFT neuromorphic processor
* Monolithic 145-TFT budget (M1 to M145). Single DC supply VDD = 3.30 V, VSS = 0.00 V.
* Zero external negative supply rails. Zero hidden subcircuits.
* Production sign-off netlist for flexible substrate pre-tapeout.
* ==================================================================

.options TEMP=27 GMIN=1e-14 ABSTOL=1e-15 VNTOL=1e-7 RELTOL=1e-4
+ CHGTOL=1e-16 ITL1=500 ITL2=200 ITL4=500 METHOD=GEAR MAXORD=2

* ---- p-type organic TFT (DNTT / SAM gate dielectric), aged corner ----
* KP = mu*Cox = 1.0e-7 A/V^2  (mu ~ 3 cm2/Vs, Cox ~ 33 nF/cm2)
* VTO = -1.20 V  = fully-walked-out |Vth| (nominal 0.85 V + 350 mV)
* .model PORG PMOS (LEVEL=1 VTO=-1.20 KP=1.0e-7 GAMMA=0 PHI=0.60   (replaced by potft)
.include ../models/trace2_otft_v2.sub
.include ../models/trace2_otft_seg.sub
.lib ../models/vth_sweep.lib lab_vth085
* + LAMBDA=0.010 CGSO=2.0e-10 CGDO=2.0e-10 CGBO=1.0e-10
* + CBD=0 CBS=0 CJ=0 CJSW=0 IS=1.0e-16 RD=0 RS=0)

* ------------------------- single DC supply -------------------------
VDD    vdd  0  DC 3.30

* --------------------- row (input) drivers ------------------------
* Phase B (1.0 us to 11.0 us): all 6 rows active-low (1.62 V) for calibration
* Phase C (11.0 us to 65.0 us): test vector x = [1, 1, 1, 0, 0, 0]
* Standby (65.0 us to 100.0 us): rows return to 3.30 V (quiescent standby)
VR1  row1 0  PWL(0 3.3 301.0u 3.3 302.0u 1.62 310.0u 1.62 311.0u 3.3 312.50u 3.3 312.70u 1.62 461.64u 1.62 461.84u 3.3 507.50u 3.3 507.70u 2.2)
VR2  row2 0  PWL(0 3.3 301.0u 3.3 302.0u 1.62 310.0u 1.62 311.0u 3.3 312.50u 3.3 312.70u 1.62 439.15u 1.62 439.35u 3.3 507.50u 3.3 507.70u 2.2)
VR3  row3 0  PWL(0 3.3 301.0u 3.3 302.0u 1.62 310.0u 1.62 311.0u 3.3 312.50u 3.3 312.70u 1.62 439.30u 1.62 439.50u 3.3 507.50u 3.3 507.70u 2.2)
VR4  row4 0  PWL(0 3.3 301.0u 3.3 302.0u 1.62 310.0u 1.62 311.0u 3.3 312.50u 3.3 312.70u 1.62 469.04u 1.62 469.24u 3.3 507.50u 3.3 507.70u 2.2)
VR5  row5 0  PWL(0 3.3 301.0u 3.3 302.0u 1.62 310.0u 1.62 311.0u 3.3 312.50u 3.3 312.70u 1.62 416.65u 1.62 416.85u 3.3 507.50u 3.3 507.70u 2.2)
VR6  row6 0  PWL(0 3.3 301.0u 3.3 302.0u 1.62 310.0u 1.62 311.0u 3.3 312.50u 3.3 312.70u 1.62 415.99u 1.62 416.19u 3.3 507.50u 3.3 507.70u 2.2)

* ------------------- integration capacitance ----------------------
CVBOOTDUMMY vboot 0 1p
CRAIL1  ap1 0 375.0p
CRAIL2  ap2 0 375.0p
CRAIL3  ap3 0 375.0p
CRAIL4  ap4 0 375.0p
CRAIL5  ap5 0 375.0p
CREF    ref 0 24.0p
.ic v(ap1)=3.420 v(ap2)=3.391 v(ap3)=3.368 v(ap4)=3.280 v(ap5)=2.932 v(na1)=3.185 v(na2)=0.247 v(na3)=0.247 v(na4)=0.247 v(na5)=0.247 v(nb1)=0.757 v(nb2)=3.033 v(nb3)=3.033 v(nb4)=3.033 v(nb5)=3.033 v(d1)=2.824 v(d2)=2.824 v(d3)=2.824 v(d4)=2.824 v(d5)=2.824 v(ref)=1.574 v(win)=3.212 v(lockb)=0.726 v(vls)=3.196 v(vboot)=0
CD1     d1  0 0.20p
CNA1    na1 0 0.20p
CNB1    nb1 0 0.20p
CACOL1  acol1 0 0.20p
RACOL1  acol1 vdd 1T
CD2     d2  0 0.20p
CNA2    na2 0 0.20p
CNB2    nb2 0 0.20p
CACOL2  acol2 0 0.20p
RACOL2  acol2 vdd 1T
CD3     d3  0 0.20p
CNA3    na3 0 0.20p
CNB3    nb3 0 0.20p
CACOL3  acol3 0 0.20p
RACOL3  acol3 vdd 1T
CD4     d4  0 0.20p
CNA4    na4 0 0.20p
CNB4    nb4 0 0.20p
CACOL4  acol4 0 0.20p
RACOL4  acol4 vdd 1T
CD5     d5  0 0.20p
CNA5    na5 0 0.20p
CNB5    nb5 0 0.20p
CACOL5  acol5 0 0.20p
RACOL5  acol5 vdd 1T
CACOM   acom 0 0.20p
RACOM   acom 0 1T
CWIN win 0 0.3p
XNP1 na1 rstb vdd potft W=20 L=5   $ na precharge (history equaliser)
XNP2 na2 rstb vdd potft W=20 L=5   $ na precharge (history equaliser)
XNP3 na3 rstb vdd potft W=20 L=5   $ na precharge (history equaliser)
XNP4 na4 rstb vdd potft W=20 L=5   $ na precharge (history equaliser)
XNP5 na5 rstb vdd potft W=20 L=5   $ na precharge (history equaliser)
XWR win rstr vdd potft W=10 L=5 DVTH=0.12357   $ precharge win high during reset (keeps win >= 0)
CLOCKB lockb 0 0.20p

* ============ M1-M30 : EXCITATORY 2T-CELL HALF (A+) ===============
X1 ap1 row1 vdd potftseg W=90 L=54 DVTH=0.04335
* X2 removed: 0 fingers
X3 ap1 row3 vdd potftseg W=40 L=54 DVTH=0.02871
