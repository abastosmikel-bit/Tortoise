X108 nb3 rstr vdd potft W=40 L=5 DVTH=-0.02118
X109 d3 lockb vdd potft W=20 L=5 DVTH=-0.11777   $ lock: pulls d3 high when lockb low
X110 win nb3 vdd potft W=80 L=5 DVTH=-0.03249   $ P_k: wired-OR pull-up of win

* ---- class 4 (M111-M120) ----
X111 d4 ap4 vls potft W=468 L=15 DVTH=0.01295
X112 0 0 d4 potft W=20 L=20 DVTH=-0.10248
X113 na4 d4 vdd potft W=200 L=10 DVTH=-0.03103
X114 0 0 na4 potft W=10 L=20 DVTH=0.02598
X115 na4 nb4 vdd potft W=60 L=5 DVTH=0.06128
X116 nb4 na4 vdd potft W=60 L=5 DVTH=-0.00657
X117 0 0 nb4 potft W=20 L=5 DVTH=-0.08575
X118 nb4 rstr vdd potft W=40 L=5 DVTH=0.06547
X119 d4 lockb vdd potft W=20 L=5 DVTH=-0.06529   $ lock: pulls d4 high when lockb low
X120 win nb4 vdd potft W=80 L=5 DVTH=0.14387   $ P_k: wired-OR pull-up of win

* ---- class 5 (M121-M130) ----
X121 d5 ap5 vls potft W=468 L=15 DVTH=0.02195
X122 0 0 d5 potft W=20 L=20 DVTH=0.13221
X123 na5 d5 vdd potft W=200 L=10 DVTH=-0.03272
X124 0 0 na5 potft W=10 L=20 DVTH=-0.05467
X125 na5 nb5 vdd potft W=60 L=5 DVTH=-0.02734
X126 nb5 na5 vdd potft W=60 L=5 DVTH=-0.10847
X127 0 0 nb5 potft W=20 L=5 DVTH=-0.08387
X128 nb5 rstr vdd potft W=40 L=5 DVTH=0.09190
X129 d5 lockb vdd potft W=20 L=5 DVTH=-0.15372   $ lock: pulls d5 high when lockb low
X130 win nb5 vdd potft W=80 L=5 DVTH=-0.02484   $ P_k: wired-OR pull-up of win

* ====================================================================
* M131-M132 : SHARED GLOBAL BOOTSTRAP DRIVER (ON-CHIP BIAS GENERATOR)
* ====================================================================
* Single on-chip bootstrap driver generates negative bias node (vboot = -1.25 V)
* from sequencer falling edge. Replaces 24 redundant distributed bootstrap TFTs.
* C_BOOT_VB removed (ideal vboot)
* X131 vboot vboot 0 potft W=10 L=5   $ M_cl : Negative diode clamp to -|Vth| (removed)
* X132 vboot vdd vdd potft W=5 L=50 $ M_iso: Leakage isolation / pull-up (removed)

* ====================================================================
* M133-M140 : AUTONOMOUS 8-TFT MONOSTABLE CLOCK SEQUENCER (SEQ8)
* ====================================================================
* Stage 1: Phase A Monostable Timer (CA = 1.8 pF, TA = 1.0 us)
* removed (SEQ8 replaced by host timing): X133 0 rst_coarse na potft W=40 L=5
* removed (SEQ8 replaced by host timing): X134 na 0 vdd potft W=90 L=5
* removed (SEQ8 replaced by host timing): CA    na  0          1.8p
* removed (SEQ8 replaced by host timing): X135 rst_fine na vdd potft W=100 L=5
* removed (SEQ8 replaced by host timing): X136 0 0 rst_fine potft W=10 L=20

* Stage 2: Phase B Monostable Timer (CB = 18.0 pF, TB = 10.0 us)
* removed (SEQ8 replaced by host timing): X137 0 rst_fine nb potft W=40 L=5
* removed (SEQ8 replaced by host timing): X138 nb 0 vdd potft W=90 L=5
* removed (SEQ8 replaced by host timing): CB    nb  0          18.0p
* removed (SEQ8 replaced by host timing): X139 phib_seq nb vdd potft W=100 L=5
* removed (SEQ8 replaced by host timing): X140 0 win phib_seq potft W=10 L=20

* Monolithic internal timing waveforms derived from sequencer
* removed (SEQ8 replaced by host timing): V_RST_COARSE rst_coarse 0 PWL(0 0.00 600n 0.00 605n 3.30)
* removed (SEQ8 replaced by host timing): V_RST_FINE   rst_fine   0 PWL(0 3.30 600n 3.30 605n 0.00)
V_RSTB rstb 0 PWL(0 0 150u 0 151u 3.3)
V_RSTR rstr 0 PWL(0 3.3 20.0u 0.00 311.5u 0.00 312.5u 3.3)
V_PHIB phib 0 PWL(0 0 309.0u 0 310.0u 3.3)
V_PHI phi 0 PWL(0 3.3 309.0u 3.3 310.0u 0)

* ====================================================================
* M141-M145 : MONOLITHIC PARALLEL REPAIR SPARES (GATE=VDD, HARD-OFF)
* ====================================================================
* External 6.00 V programming probe protection is located OFF-CHIP on the probe fixture.
* These 5 reserve TFTs are dedicated 100% to laser-linkable parallel redundancy across
* the 5 most critical single-point failure sites (M61, M62, M65, M66, M80),
* achieving P_die_red = 6.526% (boosting yield by +1.18% over raw 5.343%).
X141 0 vdd vdd potft W=20 L=10 DVTH=0.14823
X142 0 vdd vdd potft W=20 L=10 DVTH=0.02664
X143 0 vdd vdd potft W=20 L=10 DVTH=0.04677
X144 0 vdd vdd potft W=20 L=10 DVTH=-0.00308
X145 0 vdd vdd potft W=20 L=10 DVTH=-0.06916

* ------------------------- analysis --------------------------------
.tran 100n 1408u 0 100n

.measure tran v_ref_hold   FIND v(ref)   AT=10.9u
.measure tran v_vls_hold   FIND v(vls)   AT=10.9u
.measure tran v_n1_bias    FIND v(n1)    AT=10.9u
.measure tran v_comp_bias  FIND v(comp)  AT=10.9u
.measure tran t_trip1      WHEN v(na1)=1.65 RISE=1
.measure tran v_ap1_trip   FIND v(ap1)   WHEN v(na1)=1.65 RISE=1
.measure tran vout1_final  FIND v(na1)   AT=699u
.measure tran vrail1_final FIND v(ap1)   AT=699u
.measure tran vout2_final  FIND v(na2)   AT=699u
.measure tran vrail2_final FIND v(ap2)   AT=699u
.measure tran vout3_final  FIND v(na3)   AT=699u
.measure tran vrail3_final FIND v(ap3)   AT=699u
.measure tran vout4_final  FIND v(na4)   AT=699u
.measure tran vrail4_final FIND v(ap4)   AT=699u
.measure tran vout5_final  FIND v(na5)   AT=699u
.measure tran vrail5_final FIND v(ap5)   AT=699u
.measure tran v_winb_final FIND v(win)  AT=699u
.measure tran vboot_hold   FIND v(vboot) AT=50u
.measure tran i_vdd_standby FIND i(vdd)  AT=699u

.control
run
print v(ref) v(vls) v(n1) v(comp)
.endc
* VVBOOT removed: no negative bias in T4
.end
